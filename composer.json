{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^7.4 || ^8.0",
        "campusdigital/campuscms": "^1.3",
        "fideloper/proxy": "^4.2",
        "fruitcake/laravel-cors": "^2.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "laravel/framework": "^8.0",
        "laravel/sanctum": "^2.15",
        "laravel/tinker": "^2.0"
    },
    "require-dev": {
        "facade/ignition": "^2.3.6",
        "fzaninotto/faker": "^1.9.1",
        "mockery/mockery": "^1.3.1",
        "nunomaduro/collision": "^5.0",
        "phpunit/phpunit": "^9.3"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform-check": false,
        "platform": {
            "php": "7.4.33"
        },
        "audit": {
            "ignore": [
                "PKSA-cv56-2228-pzr6",
                "PKSA-6r8f-nxsb-67bq",
                "PKSA-gh7h-hhy4-byg7",
                "PKSA-mwt3-h9tv-kx78",
                "PKSA-hp6n-n4kz-21wk",
                "PKSA-mckv-s5hg-868k",
                "PKSA-qstp-ffwg-8hp6",
                "PKSA-5vz3-q51h-7mg4",
                "PKSA-7ztm-rpt3-qqzk",
                "PKSA-4jrs-y99s-q8j6",
                "PKSA-hbk6-2vfz-8f8n",
                "PKSA-kj9c-tr41-t8mj",
                "PKSA-872h-8556-2chm",
                "PKSA-99tj-gg5v-4g74",
                "PKSA-qsyb-3psh-f1t3",
                "PKSA-3dsp-r6t7-8xmz",
                "PKSA-cwpj-dtf9-6fg1"
            ]
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}